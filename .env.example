# ── Required ────────────────────────────────────────────────
APIFY_TOKEN=your_apify_token_here
GCP_PROJECT_ID=your-gcp-project-id

# ── Optional: BigQuery table names (defaults shown) ──────────
BQ_DATASET=real_estate
BQ_TABLE=listings

# ── Optional: Notifications ──────────────────────────────────

# ntfy.sh push notifications (free, no account needed)
# 1. Pick a unique topic name (treat it like a password)
# 2. Install the ntfy app on your phone
# 3. Subscribe to your topic in the app
NTFY_TOPIC=my-realestate-abc123

# Gmail email digest
# Use an App Password (not your real password):
# Google Account → Security → 2FA → App Passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFY_EMAIL=you@gmail.com

# ── Optional: scraper tuning ─────────────────────────────────
MAX_ITEMS_PER_SOURCE=50   # lower = less Apify credit usage
